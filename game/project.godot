; Engine configuration file.
; It's best edited using the editor UI and not directly,
; since the parameters that go here are not all obvious.
;
; Format:
;   [section] ; section goes between []
;   param=value ; assign values to parameters

config_version=5

[application]

config/name="Signcaster"
run/main_scene="res://skins/debug/debug_main.tscn"
config/features=PackedStringArray("4.7", "Forward Plus")

[autoload]

EventBus="*res://engine/event_bus.gd"
Clock="*res://engine/clock.gd"
Config="*res://engine/config.gd"
SaveSystem="*res://engine/save_system.gd"
WordBank="*res://engine/word_bank.gd"
Difficulty="*res://engine/difficulty.gd"
Economy="*res://engine/economy.gd"
Store="*res://engine/store.gd"
TrackerClient="*res://engine/tracker_client.gd"
ChallengeManager="*res://engine/challenge_manager.gd"
Game="*res://engine/game.gd"

[debug]

gdscript/warnings/untyped_declaration=2

[display]

window/size/viewport_width=1280
window/size/viewport_height=720
window/stretch/mode="canvas_items"
window/stretch/aspect="expand"

[editor_plugins]

enabled=PackedStringArray("res://addons/gut/plugin.cfg")
